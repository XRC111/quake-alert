# 复制为 keystore.properties 后填入本地值；该文件已在 .gitignore 中，不会入库。
# CI 环境下这些值由 GitHub Secrets 注入，优先级高于本文件。

# 签名文件路径（绝对路径或相对项目根目录）
KEYSTORE_FILE=/absolute/path/to/quake.jks
KEYSTORE_PASSWORD=your_store_password
KEY_ALIAS=quake
KEY_PASSWORD=your_key_password

# macOS 公证（可选，仅桌面端打包需要）
NOTARIZATION_TEAM_ID=
NOTARIZATION_APPLE_ID=
NOTARIZATION_PASSWORD=
NOTARIZATION_IDENTITY=Developer ID Application
